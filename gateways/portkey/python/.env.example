# Portkey API key (https://app.portkey.ai/api-keys)
PORTKEY_API_KEY=pk-...

# Virtual key — Portkey dashboard 에서 발급, provider 키(OpenAI 등)는 Portkey 가 보관
PORTKEY_VIRTUAL_KEY=openai-virtual-...

# Self-hosting 시: 게이트웨이 base URL (기본 https://api.portkey.ai/v1)
# PORTKEY_BASE_URL=http://localhost:8787/v1
