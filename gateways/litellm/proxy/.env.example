# Proxy Admin 키. 가상 키 발급/삭제 등 관리 API 호출 시 사용. sk- 로 시작해야 함.
LITELLM_MASTER_KEY=sk-1234

# 모델 API 키를 DB 에 저장할 때 암호화/복호화 용도. 모델을 한 번이라도 추가한 뒤에는 절대 바꾸지 말 것.
# 운영에서는 https://1password.com/password-generator/ 등으로 랜덤 값 생성 권장.
LITELLM_SALT_KEY=sk-salt-1234

# config.yaml 에 등록한 모델 중 실제로 쓸 provider 키만 채우면 됨.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
